# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - BORROWAPP BACKEND (.env.example)
# Copia este archivo como `.env` dentro de `backend/` y ajusta tus credenciales.
# NUNCA subas el archivo `.env` al repositorio.
# ==============================================================================

# Base de datos:
# - Desarrollo local sin servidor externo (por defecto):
DATABASE_URL=sqlite:///./borrowapp.db
# - Producción / Supabase PostgreSQL (con SSL requerido):
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.tu-proyecto.supabase.co:5432/postgres?sslmode=require

# Clave secreta para firmar los tokens JWT (cámbiala por una cadena larga y aleatoria en producción):
CLAVE_SECRETA=cambia-esta-clave-secreta-en-produccion-borrowapp-2026

# Cargar semillas de ejemplo del SRS v1.1 al iniciar el servidor (true / false):
CARGAR_DATOS_EJEMPLO=true

